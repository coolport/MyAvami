import {
  Box,
  Flex,
  Heading,
  Input,
  Table,
  Text,
  Image,
  Button,
  Spinner,
  Badge,
  // Modal,
  // ModalOverlay,
  // ModalContent,
  // ModalHeader,
  // ModalCloseButton,
  // ModalBody,
  // ModalFooter,
} from "@chakra-ui/react"
import { FiSearch, FiEdit2, FiTrash2, FiX } from "react-icons/fi"
import { useForm } from "react-hook-form"

function Inventory() {
  searchTerm,
    setSearchTerm,
    filteredInventory,
    loading,
    handleEdit,
    handleDelete,
    editingItem,
    setEditingItem,
    deleteConfirm,
    setDeleteConfirm,
    confirmDelete,
    onEditSubmit,
    formatPrice,
    formatDate,
    getStockStatus,

const editForm = useForm({ defaultValues: editingItem || {} })

  return (
    <Box px={8} py={6}>
      <Heading mb={6}>Inventory</Heading>

      <Flex mb={4} justify="space-between" align="center" flexWrap="wrap" gap={4}>
        <Flex align="center" flex="1" maxW="400px">
          <FiSearch style={{ marginRight: "8px" }} />
          <Input
            placeholder="Search by name, description, or category..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
          />
        </Flex>

        <Text fontWeight="bold">
          Total Items: {filteredInventory.length}
        </Text>
      </Flex>

      {/* Table */}
      <Box overflowX="auto" borderWidth="1px" borderRadius="md">
        <Table.Root variant="simple">
          <Table.Header bg="gray.100">
            <Table.Row>
              <Table.ColumnHeader>Product</Table.ColumnHeader>
              <Table.ColumnHeader>Category</Table.ColumnHeader>
              <Table.ColumnHeader>Price</Table.ColumnHeader>
              <Table.ColumnHeader>Stock</Table.ColumnHeader>
              <Table.ColumnHeader>Expiration</Table.ColumnHeader>
              <Table.ColumnHeader>Actions</Table.ColumnHeader>
            </Table.Row>
          </Table.Header>
          <Table.Body>
            {loading ? (
              <Table.Row>
                <Table.Cell colSpan={6} textAlign="center">
                  <Spinner size="sm" mr={2} />
                  Loading inventory...
                </Table.Cell>
              </Table.Row>
            ) : filteredInventory.length === 0 ? (
              <Table.Row>
                <Table.Cell colSpan={6} textAlign="center" py={4}>
                  {searchTerm
                    ? "No items match your search"
                    : "No inventory items found"}
                </Table.Cell>
              </Table.Row>
            ) : (
              filteredInventory.map((item, index) => {
                const stockStatus = getStockStatus(item.itemCount);
                return (
                  <Table.Row key={item._id || index}>
                    <Table.Cell>
                      <Flex align="center">
                        <Image
                          src={item.itemImage}
                          alt={item.itemName}
                          boxSize="50px"
                          borderRadius="md"
                          mr={3}
                          fallbackSrc="https://via.placeholder.com/50"
                        />
                        <Box>
                          <Text fontWeight="medium">{item.itemName}</Text>
                          <Text fontSize="sm" color="gray.500">
                            {item.itemDescription}
                          </Text>
                        </Box>
                      </Flex>
                    </Table.Cell>
                    <Table.Cell>
                      <Badge colorScheme="purple">{item.itemCategory}</Badge>
                    </Table.Cell>
                    <Table.Cell>{formatPrice(item.itemPrice)}</Table.Cell>
                    <Table.Cell>
                      <Box>
                        <Text fontWeight="bold">{item.itemCount}</Text>
                        <Badge colorScheme={stockStatus.className}>
                          {stockStatus.label}
                        </Badge>
                      </Box>
                    </Table.Cell>
                    <Table.Cell>{formatDate(item.itemExpiration)}</Table.Cell>
                    <Table.Cell>
                      <Flex gap={2}>
                        <Button
                          size="sm"
                          colorScheme="blue"
                          onClick={() => handleEdit(item)}
                          leftIcon={<FiEdit2 />}
                        >
                          Edit
                        </Button>
                        <Button
                          size="sm"
                          colorScheme="red"
                          onClick={() => handleDelete(item)}
                          leftIcon={<FiTrash2 />}
                        >
                          Delete
                        </Button>
                      </Flex>
                    </Table.Cell>
                  </Table.Row>
                );
              })
            )}
          </Table.Body>
        </Table.Root>
      </Box>


      {editingItem && (
        <div style={{
          position: 'fixed',
          inset: 0,
          backgroundColor: 'rgba(0,0,0,0.5)',
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center',
          zIndex: 1000
        }}>
          <div style={{
            backgroundColor: 'white',
            padding: '20px',
            borderRadius: '8px',
            width: '500px',
            boxShadow: '0 4px 12px rgba(0,0,0,0.3)'
          }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '12px' }}>
              <h2>Edit Product</h2>
              <button onClick={() => setEditingItem(null)} style={{
                border: 'none',
                background: 'transparent',
                fontSize: '18px',
                cursor: 'pointer'
              }}>×</button>
            </div>

            <form onSubmit={editForm.handleSubmit(onEditSubmit)} style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
              <input {...editForm.register("itemName", { required: true })} placeholder="Product Name" />
              <input {...editForm.register("itemDescription", { required: true })} placeholder="Description" />
              <input {...editForm.register("itemPrice", { required: true })} type="number" placeholder="Price (PHP)" />
              <input {...editForm.register("itemCount", { required: true })} type="number" placeholder="Stock Count" />
              <input {...editForm.register("itemCategory", { required: true })} placeholder="Category" />
              <input {...editForm.register("itemExpiration")} type="date" />
              <input {...editForm.register("itemImage", { required: true })} type="url" placeholder="Image URL" />
              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '10px' }}>
                <button type="button" onClick={() => setEditingItem(null)} style={{
                  padding: '8px 12px',
                  borderRadius: '4px',
                  border: '1px solid gray',
                  backgroundColor: 'white',
                  cursor: 'pointer'
                }}>Cancel</button>
                <button type="submit" style={{
                  padding: '8px 12px',
                  borderRadius: '4px',
                  border: 'none',
                  backgroundColor: '#3182CE',
                  color: 'white',
                  cursor: 'pointer'
                }}>Save Changes</button>
              </div>
            </form>
          </div>
        </div>
      )}



      {deleteConfirm && (
        <div style={{
          position: 'fixed',
          inset: 0,
          backgroundColor: 'rgba(0,0,0,0.5)',
          display: 'flex',
          justifyContent: 'center',
          alignItems: 'center',
          zIndex: 1000
        }}>
          <div style={{
            backgroundColor: 'white',
            padding: '20px',
            borderRadius: '8px',
            width: '400px',
            boxShadow: '0 4px 12px rgba(0,0,0,0.3)'
          }}>
            <h3 style={{ marginBottom: '10px' }}>Delete Product</h3>
            <p>Are you sure you want to delete <strong>{deleteConfirm.itemName}</strong>?</p>
            <p style={{ color: 'red', marginTop: '10px' }}>This action cannot be undone.</p>
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '20px' }}>
              <button onClick={() => setDeleteConfirm(null)} style={{
                padding: '8px 12px',
                borderRadius: '4px',
                border: '1px solid gray',
                backgroundColor: 'white',
                cursor: 'pointer'
              }}>Cancel</button>
              <button onClick={confirmDelete} style={{
                padding: '8px 12px',
                borderRadius: '4px',
                border: 'none',
                backgroundColor: '#E53E3E',
                color: 'white',
                cursor: 'pointer'
              }}>Delete</button>
            </div>
          </div>
        </div>
      )}
    </Box>
  )
}
export default Inventory
